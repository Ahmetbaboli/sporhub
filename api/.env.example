# Just Sport API — copy to .env and fill in. Never commit .env.

# Async PostgreSQL connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://justsport:justsport@localhost:5432/justsport
# Redis cache. Leave empty to disable caching.
REDIS_URL=redis://localhost:6379/0
# football-data.org v4 token (https://www.football-data.org/client/register).
FOOTBALL_DATA_API_KEY=
# balldontlie token (used from Stage 3).
BALLDONTLIE_API_KEY=
# live (default) = real provider data only; a provider without its key shows "not configured".
# demo = bundled fixtures + sample news, labelled "Örnek veri" on every page. Never use demo on a
# public site. Remove demo rows from a database with: python -m app.scripts.purge_demo
DATA_MODE=live
# Shared secret for POST /api/v1/admin/sync/{adapter} (X-Admin-Token header).
ADMIN_TOKEN=change-me
# Comma separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
# debug | info | warning | error
LOG_LEVEL=info
# Run the background refresh (live mode only). Intervals adapt to live/today/idle matches
# (app/services/sync_planner.py); one process holds a lock so replicas never sync twice.
SCHEDULER_ENABLED=false
# true = run `python -m app.scripts.seed` (fixture data) when the container starts.
# Only honoured with DATA_MODE=demo.
SEED_ON_START=false

# Shared secret (>= 32 random bytes, e.g. `openssl rand -base64 48`) used to verify the short-lived
# HS256 tokens the web app signs for signed-in users. MUST equal the web app's API_TOKEN_SECRET.
# Empty = account endpoints (/api/v1/me/*) answer 503 and the site works signed-out only.
API_TOKEN_SECRET=

# News feeds (RSS 2.0 / Atom) as a JSON list. Only headline, a short summary and the link are
# stored; the article stays on the publisher's site. Check each publisher's terms first.
# Fields: name, url, sport (football|basketball|formula-1|null), category
# (general|transfer_official|transfer_rumour|interview|tournament = default when no keyword
# matches), language (tr|en). Empty = no news sync outside fixture mode.
# Example: NEWS_FEEDS=[{"name":"ornek","url":"https://example.com/rss","sport":"football","language":"tr"}]
NEWS_FEEDS=[]
# Minutes between scheduled news syncs (only with SCHEDULER_ENABLED=true and real feeds).
NEWS_INTERVAL_MINUTES=15

# TheSportsDB v1 PREMIUM key (Süper Lig, TFF 1. Lig). The public development key "123" is
# treated as not configured: it returns truncated tables (5 rows). See docs/DATA-SOURCES.md.
THESPORTSDB_API_KEY=
