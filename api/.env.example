# Just Sport API — copy to .env and fill in. Never commit .env.

# Async PostgreSQL connection string (asyncpg driver).
DATABASE_URL=postgresql+asyncpg://justsport:justsport@localhost:5432/justsport
# Redis cache. Leave empty to disable caching.
REDIS_URL=redis://localhost:6379/0
# football-data.org v4 token (https://www.football-data.org/client/register).
FOOTBALL_DATA_API_KEY=
# balldontlie token (used from Stage 3).
BALLDONTLIE_API_KEY=
# true = adapters read api/fixtures/*.json instead of calling external APIs.
USE_FIXTURES=true
# Shared secret for POST /api/v1/admin/sync/{adapter} (X-Admin-Token header).
ADMIN_TOKEN=change-me
# Comma separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000
# debug | info | warning | error
LOG_LEVEL=info
# Run scheduled syncs inside the API process.
SCHEDULER_ENABLED=false
# Minutes between scheduled syncs.
SYNC_INTERVAL_MINUTES=30
