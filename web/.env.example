# Just Sport web — copy to .env.local. Never commit it.

# Public base URL of the Just Sport API (used by the browser and by server components).
NEXT_PUBLIC_API_URL=http://localhost:8000
# API URL used by the Next.js server inside Docker (compose service name).
# Optional: falls back to NEXT_PUBLIC_API_URL when empty.
API_INTERNAL_URL=

# --- Sign-in (Auth.js). All optional: without them the site runs signed-out, no login button. ---
# Session encryption key (`npx auth secret` or `openssl rand -base64 33`).
AUTH_SECRET=
# Needed behind a proxy / with `next start` outside Vercel (Docker, Render).
AUTH_TRUST_HOST=true
# Signs the short-lived tokens sent to the API. MUST equal the API's API_TOKEN_SECRET (>= 32 chars).
API_TOKEN_SECRET=
# GitHub OAuth app (callback: <site>/api/auth/callback/github).
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Google OAuth client (callback: <site>/api/auth/callback/google).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# true = name-only "developer login" for local demos. Ignored in production builds.
AUTH_DEV_LOGIN=false
